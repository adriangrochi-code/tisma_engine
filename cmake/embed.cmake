# Writes OUTPUT, a C++ file holding each of FILES (a list of paths) as a byte
# array: the interface carries its icons and its font (apps/tisma/embedded.hpp),
# and the engine its catalog (src/catalog/catalog_files.hpp), so they run from
# any folder. Run as cmake -DOUTPUT=... -DFILES=... [-DNAMESPACE=...
# -DHEADER=...] -P; the defaults are the interface's.
if(NOT NAMESPACE)
  set(NAMESPACE "tisma::ui")
endif()
if(NOT HEADER)
  set(HEADER "embedded.hpp")
endif()
set(arrays "")
set(table "")
set(index 0)
foreach(path IN LISTS FILES)
  file(READ "${path}" hex HEX)
  string(LENGTH "${hex}" digits)
  math(EXPR bytes "${digits} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  # A line break every 24 bytes keeps compilers' line limits far away.
  string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){24})" "\\1\n" hex "${hex}")
  get_filename_component(name "${path}" NAME)
  string(APPEND arrays "const unsigned char file_${index}[] = {\n${hex}0};\n")
  string(APPEND table "    {\"${name}\", file_${index}, ${bytes}},\n")
  math(EXPR index "${index} + 1")
endforeach()
file(WRITE "${OUTPUT}.tmp"
  "// Generated by cmake/embed.cmake from the files it names: do not edit.\n"
  "#include \"${HEADER}\"\n\n"
  "namespace ${NAMESPACE} {\nnamespace {\n${arrays}} // namespace\n\n"
  "const EmbeddedFile kEmbeddedFiles[] = {\n${table}};\n"
  "const std::size_t kEmbeddedFileCount = ${index};\n\n"
  "} // namespace ${NAMESPACE}\n")
file(RENAME "${OUTPUT}.tmp" "${OUTPUT}")
