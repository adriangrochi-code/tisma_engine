#version 450
// The squared distance from each set pixel of a grid of bits to the nearest
// unset one (squared_distance_inside, src/geom/distance.cpp), the same
// numbers: mode 0 walks one column per invocation, mode 1 one row, as the
// lower envelope of parabolas (Felzenszwalb and Huttenlocher, 2012). Own
// code; see PROVENANCE.md.

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) readonly buffer Bits { uint bits[]; };
layout(std430, set = 0, binding = 1) buffer Column { float column[]; };
layout(std430, set = 0, binding = 2) writeonly buffer Dist { float dist[]; };
layout(std430, set = 0, binding = 3) buffer Vertex { int vertex[]; };
layout(std430, set = 0, binding = 4) buffer Bound { float bound[]; };

layout(push_constant) uniform Params {
    uint width;  // pixels in a row
    uint height; // rows
    uint stride; // 32-bit words in a row
    uint mode;
    // Where this grid starts in the buffers (several grids in one run).
    uint bits_at;   // in 32-bit words
    uint pixel_at;  // in pixels: Column and Dist
    uint vertex_at; // in values: Vertex
    uint bound_at;  // in values: Bound
} params;

bool get(uint i, uint j) { return ((bits[params.bits_at + j * params.stride + i / 32u] >> (i % 32u)) & 1u) != 0u; }

// Row j's height of parabola q: 0 just past either end, else the column's square.
float height_of(uint j, int q, int n) {
    if (q == 0 || q == n - 1)
        return 0.0;
    float c = column[params.pixel_at + j * params.width + uint(q - 1)];
    return c * c;
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (params.mode == 0u) {
        if (id >= params.width)
            return;
        float run = 0.0;
        for (uint j = 0u; j < params.height; ++j) {
            run = get(id, j) ? run + 1.0 : 0.0;
            column[params.pixel_at + j * params.width + id] = run;
        }
        run = 0.0;
        for (uint j = params.height; j-- > 0u;) {
            run = get(id, j) ? run + 1.0 : 0.0;
            uint at = params.pixel_at + j * params.width + id;
            column[at] = min(column[at], run);
        }
        return;
    }
    if (id >= params.height)
        return;
    uint j = id;
    int n = int(params.width) + 2;
    uint vb = params.vertex_at + j * uint(n), zb = params.bound_at + j * uint(n + 1);
    int k = -1;
    for (int q = 0; q < n; ++q) {
        float fq = height_of(j, q, n);
        float s = 0.0;
        while (k >= 0) {
            int p = vertex[vb + uint(k)];
            s = ((fq + float(q) * float(q)) - (height_of(j, p, n) + float(p) * float(p))) / (2.0 * float(q - p));
            if (s > bound[zb + uint(k)])
                break;
            --k;
        }
        ++k;
        vertex[vb + uint(k)] = q;
        if (k == 0) {
            bound[zb] = -1.0e30;
        } else {
            int p = vertex[vb + uint(k - 1)];
            bound[zb + uint(k)] = ((fq + float(q) * float(q)) - (height_of(j, p, n) + float(p) * float(p))) / (2.0 * float(q - p));
        }
        bound[zb + uint(k + 1)] = 1.0e30;
    }
    int at = 0;
    for (int q = 1; q < n - 1; ++q) {
        while (bound[zb + uint(at + 1)] < float(q))
            ++at;
        int p = vertex[vb + uint(at)];
        float d = float(q - p);
        uint i = uint(q - 1);
        dist[params.pixel_at + j * params.width + i] = get(i, j) ? d * d + height_of(j, p, n) : 0.0;
    }
}
